{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bmc-sierra-content-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmc-sierra-content",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bmc-sierra-band-photos"
    }
  ],
  "vars": {
    "ADMIN_HOST": "admin.example.com",
    "ACCESS_ISSUER": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
